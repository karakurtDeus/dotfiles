configuration {
    modi:                        "drun";
    show-icons:                  true;
    drun-display-format:         "test";
    font:                        "Liberation Sans 12";
}

* {
    bg: #000000;
    fg: #C5C8C6;
    primary: #F0C674;
    icon-fg: #000000;
}

window {
    enabled:                     true;
    fullscreen:                  false;
    location:                    center;
    anchor:                      center;
    transparency:                "real";
    cursor:                      "default";
    spacing:                     0px;
    padding:                     0px;
    border:                      0px;
    border-radius:               0px;
    border-color:                @bg;
    background-color:            #00000066;
}

mainbox {
    enabled:                     true;
    children:                    [ "listview" ];
    background-color:            transparent;
    border:                      0px;
    border-color:                @bg;
}

listview {
    enabled:                     true;
    columns:                     6;
    lines:                       1;
    spacing:                     40px;
    padding:                     20px;
    cycle:                       true;
    dynamic:                     false;
    scrollbar:                   false;
    layout:                      vertical;
    flow:                        horizontal;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @icon-fg;
    border:                      0px;
    border-color:                @bg;
}

element,
element normal.normal,
element alternate.normal {
    enabled:                     true;
    orientation:                 vertical;
    children:                    [ "element-icon", "element-text" ];
    spacing:                     8px;
    padding:                     0px;
    border:                      0px;
    border-radius:               0px;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  @fg;
}

element selected,
element selected.normal,
element selected.active,
element selected.urgent {
    background-color:            transparent;
    text-color:                  @primary;
    border:                      0px;
}

element-icon {
    size:                        30%;
    squared:                     false;
    cursor:                      inherit;
    border:                      3px;
    border-radius:               16px;
    border-color:                transparent;
    background-color:            transparent;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    expand:                      false;
}

element-icon selected,
element-icon selected.normal,
element-icon selected.active,
element-icon selected.urgent {
    border-color:                @primary;
}

element-text {
    vertical-align:              0.5;
    horizontal-align:            0.5;
    padding:                     0px;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  @fg;
    highlight:                   none;
    expand:                      false;
}

element-text selected,
element-text selected.normal,
element-text selected.active,
element-text selected.urgent {
    text-color:                  @primary;
}
