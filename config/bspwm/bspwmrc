#! /bin/sh

# variables
RICE=$(cat "$HOME/.config/bspwm/rice")
primary=$(awk -F '=' '
  /^[[:space:]]*#/ { next }
  {
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", $1)
    if ($1 == "primary") {
      value = $2
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      print value
      exit
    }
  }
' "$HOME/.config/polybar/colors.ini")

# hotkey
pgrep -x sxhkd >/dev/null || sxhkd &

# cursor
xsetroot -xcf /usr/share/icons/Qogir-cursors/cursors/left_ptr 24

# desktop
bspc monitor -d I II III IV V VI

while IFS='=' read -r key value; do
  [ -n "$key" ] && bspc config "$key" "$value"
done < "$HOME/.config/bspwm/rices/$RICE/config/bspwm"

bspc config split_ratio 0.52
bspc config borderless_monocle true
bspc config gapless_monocle true

bspc config focused_border_color "$primary"
bspc config presel_feedback_color "$primary"

setxkbmap -layout "us,ru,ua" -option "grp:alt_shift_toggle"

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off

# compositor
pgrep -x picom >/dev/null || picom --config "$HOME/.config/picom/picom.conf" &

# notification
pkill dunst
dunst &

# buffer
pgrep -x clipmenud >/dev/null || CM_MAX_CLIPS=100 clipmenud &

# screen shot
pgrep -x flameshot >/dev/null || flameshot &

# bar
killall -q polybar
polybar down-panel &

# background — rice-wallpaper.* is only the theme-menu preview
pic_dir="$HOME/.config/bspwm/rices/$RICE/wallpapers"
wall=$(find "$pic_dir" -maxdepth 1 -type f -name 'main_*' 2>/dev/null | head -n 1)
if [ -z "$wall" ] && [ -f "$pic_dir/background.jpg" ]; then
  wall="$pic_dir/background.jpg"
fi
[ -n "$wall" ] && feh --bg-fill "$wall" &
