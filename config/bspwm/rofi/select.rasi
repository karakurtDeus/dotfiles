configuration {
    modi:                        "drun";
    show-icons:                  true;
    drun-display-format:         "test";
    font:                        "Liberation Sans 12";
}

* {
    bg: #000000;
    fg: #C5C8C6;
    primary: #F0C674;
    icon-fg: #000000;
}

window {
    enabled:                     true;
    fullscreen:                  false;
    width:                       100%;
    transparency:                "real";
    cursor:                      "default";
    spacing:                     0px;
    padding:                     0px;
    border:                      0px;
    border-radius:               0px;
    border-color:                @bg;
    background-color:            @bg;
}

mainbox {
    enabled:                     true;
    children:                    [ "listview" ];
    background-color:            @bg;
    border:                      0px;
    border-color:                @bg;
}

listview {
    enabled:                     true;
    columns:                     6;
    lines:                       1;
    spacing:                     40px;
    padding:                     20px;
    cycle:                       true;
    dynamic:                     false;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            @bg;
    text-color:                  @icon-fg;
    border:                      0px;
    border-color:                @bg;
}

element,
element normal.normal,
element alternate.normal {
    enabled:                     true;
    orientation:                 vertical;
    children:                    [ "element-icon", "element-text" ];
    spacing:                     0px;
    padding:                     7px;
    border:                      0px;
    border-radius:               20px;
    border-color:                @fg;
    cursor:                      pointer;
    background-color:            @fg;
    text-color:                  @icon-fg;
}

element selected,
element selected.normal,
element selected.active,
element selected.urgent {
    background-color:            @primary;
    text-color:                  @icon-fg;
    border:                      0px;
    border-color:                @primary;
}

element-icon {
    size:                        33%;
    cursor:                      inherit;
    border:                      0px;
    border-radius:               20px;
    border-color:                transparent;
    background-color:            transparent;
    margin:                      1px;
    text-color:                  @icon-fg;
    horizontal-align:            0.5;
    expand:                      false;
}

element-text {
    vertical-align:              1.0;
    horizontal-align:            0.5;
    padding:                     5px 0px 0px 0px;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  @icon-fg;
    highlight:                   none;
    expand:                      true;
}
